{
  "expo": {
    "name": "TripZen",
    "slug": "tripzen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tripzen",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tripzen.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan student QR badges for safe boarding.",
        "NSLocationWhenInUseUsageDescription": "Track the bus route in real-time.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Keep parents updated when the bus is in service.",
        "NFCReaderUsageDescription": "Tap student NFC badges to mark boarding.",
        "NSPhotoLibraryUsageDescription": "Attach photos to incident reports.",
        "NSMicrophoneUsageDescription": "Record audio notes for incident reports.",
        "UIBackgroundModes": ["location", "fetch", "remote-notification"],
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": []
    },
    "android": {
      "package": "com.tripzen.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "NFC"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F1B3D"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan student QR badges for safe boarding."
        }
      ],
      "expo-localization",
      "react-native-nfc-manager",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.tripzen",
          "enableGooglePay": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FCB813"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "TripZen tracks the bus during routes to keep parents informed.",
          "locationWhenInUsePermission": "TripZen tracks the bus during routes to keep parents informed.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": ""
      }
    },
    "owner": ""
  }
}
